# Copy to .env and fill in. All optional — without them the system runs on bundled
# sample data (AIS) and prints alerts to the console instead of sending them.

# Free key, email only, no card: https://aisstream.io/apikeys
AISSTREAM_KEY=

# Free bot: talk to @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Channel or group id the bot can post to (e.g. -1001234567890), or your own user id
TELEGRAM_CHAT_ID=
