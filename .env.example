# Copy to .env and fill in. All optional — without them the system runs on bundled
# sample data (AIS) and prints alerts to the console instead of sending them.

# Free key, email only, no card: https://aisstream.io/apikeys
AISSTREAM_KEY=

# Free bot: talk to @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Channel or group id the bot can post to (e.g. -1001234567890), or your own user id
TELEGRAM_CHAT_ID=

# Shared secret for the emergency webhook to maritime-social (same value as its
# INTERNAL_WEBHOOK_TOKEN). scripts/note4_sync.sh fills this in on the phone.
INTERNAL_WEBHOOK_TOKEN=

# Phone only (run.py --loop): asks GitHub to rebuild the public map every 30 min instead of
# waiting 2-7 h for the cron. Fine-grained PAT, this repository only, "Actions: Read and write"
# (cannot change code). scripts/github_token_ekle.sh writes it without showing it.
GITHUB_DISPATCH_TOKEN=
